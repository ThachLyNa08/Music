# AI service
AI_SERVICE_URL=

# SePay Payment Configuration
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_BIN=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=

UPLOAD_DIR=uploads

# Cấu hình Spotify API (Dành cho việc tích hợp lấy metadata nhạc)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
SPOTIFY_SCOPES=

# Last.fm (Optional for artist bio fallback)
LASTFM_API_KEY=

# LLM intent parser configuration (server-side only)
LLM_ENABLED=false
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
LLM_TIMEOUT_MS=8000
GEMINI_TIMEOUT_MS=12000

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_PLAYLIST_DEFAULT_SONGS=
AI_PLAYLIST_MAX_SONGS=

# Recommendation scheduler (Daily Mix + Weekly Mix)
# Bật/tắt toàn bộ cron recommendation. Mặc định: true.
# Khi false, sẽ KHÔNG đăng ký bất kỳ job Daily Mix hay Weekly Mix nào.
# Job avatar/cover/album/AI retrain KHÔNG bị ảnh hưởng.
# ENABLE_RECOMMENDATION_SCHEDULER=true
# RECOMMENDATION_SCHEDULER_SHARED_RUNNER=true
# RECOMMENDATION_SCHEDULER_LEGACY_JOBS=false

# Test mode cho recommendation scheduler.
# Khi true, cron chạy mỗi 2 phút thay vì lịch thật (00:10 mỗi ngày, 03:30 thứ Hai).
# CHỈ dùng cho local dev. TẮT NGAY khi test xong.
# RECOMMENDATION_SCHEDULER_TEST_MODE=false

# System Playlist Scheduler cron
SYSTEM_PLAYLIST_CRON_ENABLED=false
SYSTEM_PLAYLIST_CRON_SCHEDULE=0 0 * * *
SYSTEM_PLAYLIST_CRON_TIMEZONE=Asia/Ho_Chi_Minh
SYSTEM_PLAYLIST_CRON_LOCK_TTL_MINUTES=120
SYSTEM_PLAYLIST_CRON_RUN_ON_STARTUP=true
SYSTEM_PLAYLIST_CRON_STARTUP_DELAY_SECONDS=10

# Song release scheduler
ARTIST_RELEASE_REVIEW_LEAD_TIME_DAYS=15
SONG_RELEASE_CRON_ENABLED=false
SONG_RELEASE_CRON_SCHEDULE=*/5 * * * *
SONG_RELEASE_CRON_TIMEZONE=Asia/Ho_Chi_Minh
