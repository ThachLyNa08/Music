PORT=3000
NODE_ENV=development

JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=3d

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=musicflow
DB_USER=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

FRONTEND_URL=http://127.0.0.1:5173
APP_FRONTEND_URL=http://127.0.0.1:5173
APP_BACKEND_URL=http://127.0.0.1:3000

MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=MusicFlow
MAIL_FROM_EMAIL=no-reply@musicflow.local

ARTIST_ACCOUNT_DOMAIN=artist.musicflow.local
ARTIST_DEFAULT_TEMP_PASSWORD=
ARTIST_INVITATION_EXPIRES_HOURS=24

# AI service
AI_SERVICE_URL=http://127.0.0.1:8000

# SePay Payment Configuration
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_BIN=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=

UPLOAD_DIR=uploads

# Spotify API (optional metadata integration)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
SPOTIFY_SCOPES=

# Last.fm (optional artist bio fallback)
LASTFM_API_KEY=

# LLM intent parser (server-side only)
LLM_ENABLED=false
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
LLM_TIMEOUT_MS=8000
GEMINI_TIMEOUT_MS=12000

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_PLAYLIST_DEFAULT_SONGS=
AI_PLAYLIST_MAX_SONGS=

# Recommendation scheduler - leave disabled for a fresh local install
ENABLE_RECOMMENDATION_SCHEDULER=false
RECOMMENDATION_SCHEDULER_TEST_MODE=false

# System Playlist Scheduler
SYSTEM_PLAYLIST_CRON_ENABLED=false
SYSTEM_PLAYLIST_CRON_SCHEDULE=0 0 * * *
SYSTEM_PLAYLIST_CRON_TIMEZONE=Asia/Ho_Chi_Minh
SYSTEM_PLAYLIST_CRON_LOCK_TTL_MINUTES=120
SYSTEM_PLAYLIST_CRON_RUN_ON_STARTUP=false
SYSTEM_PLAYLIST_CRON_STARTUP_DELAY_SECONDS=10

# Song release scheduler
ARTIST_RELEASE_REVIEW_LEAD_TIME_DAYS=15
SONG_RELEASE_CRON_ENABLED=false
SONG_RELEASE_CRON_SCHEDULE=*/5 * * * *
SONG_RELEASE_CRON_TIMEZONE=Asia/Ho_Chi_Minh
