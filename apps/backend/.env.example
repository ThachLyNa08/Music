PORT=
NODE_ENV=

JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=3

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# AI service
AI_SERVICE_URL=

# SePay Payment Configuration
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_BIN=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=

UPLOAD_DIR=uploads

# Cấu hình Spotify API (Dành cho việc tích hợp lấy metadata nhạc)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
SPOTIFY_SCOPES=

# Last.fm (Optional for artist bio fallback)
LASTFM_API_KEY=

# Gemini AI API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=
AI_PLAYLIST_DEFAULT_SONGS=
AI_PLAYLIST_MAX_SONGS=

# Recommendation scheduler (Daily Mix + Weekly Mix)
# Bật/tắt toàn bộ cron recommendation. Mặc định: true.
# Khi false, sẽ KHÔNG đăng ký bất kỳ job Daily Mix hay Weekly Mix nào.
# Job avatar/cover/album/AI retrain KHÔNG bị ảnh hưởng.
# ENABLE_RECOMMENDATION_SCHEDULER=true

# Test mode cho recommendation scheduler.
# Khi true, cron chạy mỗi 2 phút thay vì lịch thật (00:10 mỗi ngày, 03:30 thứ Hai).
# CHỈ dùng cho local dev. TẮT NGAY khi test xong.
# RECOMMENDATION_SCHEDULER_TEST_MODE=false
